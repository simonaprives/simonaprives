---
layout: layouts/base.njk
templateClass: tmpl-exhibits
tags:
  - nav
  - topNav
navtitle: Exhibits
navOrder: 1
permalink: exhibits/index.html
---

<p><a href="{{ '/' | url }}">← Home</a></p>

<article>
  <h1>Exhibits</h1>

  {% if exhibits.length > 0 %}
    <section class="carousel carousel--scroll-buttons carousel--scroll-markers">
      {% for exhibit in exhibits %}
        <figure class="carousel__slide" data-label="{{ exhibit.title }}">
          {% if exhibit.images[0] and exhibit.images[0].asset %}
            {% set imageUrl = metadata.imageUrl(exhibit.images[0], 1200) %}
            <img src="{{ imageUrl }}" alt="{{ exhibit.images[0].alt or exhibit.title }}" style="view-transition-name: exhibit-{{ exhibit.slug }};">
          {% elif exhibit.mainImage and exhibit.mainImage.asset %}
            {% set imageUrl = metadata.imageUrl(exhibit.mainImage, 1200) %}
            <img src="{{ imageUrl }}" alt="{{ exhibit.title }}" style="view-transition-name: exhibit-{{ exhibit.slug }};">
          {% endif %}
          <figcaption>
            <a href="/exhibits/{{ exhibit.slug }}/">{{ exhibit.title }}</a>
          </figcaption>
        </figure>
      {% endfor %}
    </section>
  {% endif %}
  
</article>
<article>
  <h2>All Exhibits</h2>
  {% if exhibits.length > 0 %}
    <ul class="exhibits-grid">
      {% for exhibit in exhibits %}
        <li>
          <div>
            {% if exhibit.previewImageUrl %}
              <a href="/exhibits/{{ exhibit.slug }}/">
                <img src="{{ exhibit.previewImageUrl }}" alt="{{ exhibit.title }}" style="view-transition-name: exhibit-{{ exhibit.slug }};">
              </a>
            {% endif %}
            <h2 class="item-title">
              <a href="/exhibits/{{ exhibit.slug }}/">{{ exhibit.title }}</a>
            </h2>
          </div>
        </li>{% endfor %}
    </ul>
  {% endif %}

</article>
