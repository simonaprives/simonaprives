---
layout: layouts/base.njk
templateClass: tmpl-exhibits
tags:
  - nav
  - topNav
navtitle: Exhibits
navOrder: 1
permalink: exhibits/index.html
---

<p><a href="{{ '/' | url }}">← Home</a></p>

<article>
  <h1>Exhibits</h1>

  {% if exhibits.length > 0 %}
    <section class="carousel carousel--scroll-buttons carousel--scroll-markers">
      {% for exhibit in exhibits %}
        {% if exhibit.images %}
          {% for image in exhibit.images %}
            <figure class="carousel__slide" data-label="{{ exhibit.title }}">
              {% if image.asset %}
                {% set imageUrl = metadata.imageUrl(image, 1200) %}
                <img src="{{ imageUrl }}" alt="{{ image.alt or exhibit.title }}">
                <figcaption>
                  <a href="/exhibits/{{ exhibit.slug }}/">{{ exhibit.title }}</a>
                </figcaption>
              {% endif %}
            </figure>
          {% endfor %}
        {% endif %}
      {% endfor %}
    </section>
  {% endif %}
  
</article>
<article>
  <h2>All Exhibits</h2>
  {% if exhibits.length > 0 %}
    <ul class="exhibits-grid">
      {% for exhibit in exhibits %}
        <li>
          <div>
            {% if exhibit.previewImageUrl %}
              <a href="/exhibits/{{ exhibit.slug }}/">
                <img src="{{ exhibit.previewImageUrl }}" alt="{{ exhibit.title }}" style="view-transition-name: exhibit-{{ exhibit.slug }};">
              </a>
            {% endif %}
            <h2 class="item-title">
              <a href="/exhibits/{{ exhibit.slug }}/">{{ exhibit.title }}</a>
            </h2>
            {# {% if exhibit.venue or exhibit.location %}
              <p>
                {% if exhibit.venue %}{{ exhibit.venue }}{% endif %}
                {% if exhibit.venue and exhibit.location %} | {% endif %}
                {% if exhibit.location %}{{ exhibit.location }}{% endif %}
              </p>
            {% endif %}
            {% if exhibit.description %}
              <p>{{ exhibit.description }}</p>
            {% endif %} #}
          </div>
        </li>{% endfor %}
    </ul>
  {% endif %}

</article>
