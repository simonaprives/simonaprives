---
layout: layouts/base.njk
templateClass: tmpl-about
tags:
  - nav
  - topNav
navtitle: About
navOrder: 4
permalink: about/index.html
---

<p><a href="{{ '/' | url }}">← Home</a></p>

<article>
  <h1 class="screenreader-only">{{ aboutPage.title }}</h1>

  <div class="about-layout">

    {% if aboutPage.mainImageUrl %}
      <figure class="about-image">
        <img src="{{ aboutPage.mainImageUrl }}" alt="{{ aboutPage.title }}">
        {% if aboutPage.mainImageCaption %}
        <figcaption>{{ aboutPage.mainImageCaption }}</figcaption>
        {% endif %}
      </figure>
    {% endif %}

    <div class="about-content">
      {% if aboutPage.deck %}
        <h2 class="deck">{{ aboutPage.deck }}</h2>
      {% endif %}

      {% if aboutPage.bio %}
        {{ aboutPage.bio | markdownify | safe }}
      {% endif %}

      <div class="biolinks-contact">
        <p>
          <span class="biolinks-contact-label">Contact Simona</span>: 
          <a href="mailto:{{ siteSettings.contact }}" class="biolinks-contact-email">{{ siteSettings.contact }}</a>
        </p>
      </div>

    </div>
 
  </div>
  
</article>
