---
pagination:
  data: inMotion
  size: 1
  alias: motion
permalink: "in-motion/{{ motion.slug }}/"
layout: layouts/base.njk
templateClass: tmpl-in-motion-item
---

{% if motion.previewImageUrl %}
<link rel="preload" as="image" href="{{ motion.previewImageUrl }}">
{% endif %}
{% if motion.fullImageUrl %}
<link rel="preload" as="image" href="{{ motion.fullImageUrl }}">
{% endif %}

<article>
  <h1>{{ motion.title }}</h1>

  {% if motion.description %}
    <p>{{ motion.description }}</p>
  {% endif %}

  {% if motion.videos or motion.previewImageUrl %}
    <section class="carousel carousel--scroll-buttons carousel--scroll-markers" data-present-id="in-motion/{{ motion.slug }}">
      {% if motion.previewImageUrl %}
        <figure class="carousel__slide" data-label="{{ motion.title }}">
          <img
            class="vt-thumb vt-thumb--hero"
            src="{{ motion.fullImageUrl or motion.previewImageUrl }}"
            data-preview-src="{{ motion.previewImageUrl }}"
            {% if motion.presentImageUrl %}data-present-src="{{ motion.presentImageUrl }}"{% endif %}
            {% if motion.fullImageUrl %}data-full-src="{{ motion.fullImageUrl }}"{% endif %}
            alt="{{ motion.title }}"
            data-vt-name="in-motion-{{ motion.slug }}"
            data-vt-role="hero"
            {% if motion.imageWidth and motion.imageHeight %}width="{{ motion.imageWidth }}" height="{{ motion.imageHeight }}"{% endif %}
          >
        </figure>
      {% endif %}
      {% for video in motion.videos %}
        <figure class="carousel__slide" data-label="Slide {{ loop.index }}">
          {% if video.videoUrl %}
            <div class="video-embed">
              {% set videoId = video.videoUrl | replace("https://vimeo.com/", "") | replace("https://player.vimeo.com/video/", "") %}
              <iframe
                src="https://player.vimeo.com/video/{{ videoId }}"
                frameborder="0"
                allow="fullscreen; picture-in-picture"
                allowfullscreen
              ></iframe>
            </div>
          {% elif video.mainImage and video.mainImage.asset %}
            {% set imageUrl = metadata.imageUrl(video.mainImage, 1200) %}
            {% set presentUrl = metadata.imageUrl(video.mainImage, 2400) %}
            <img src="{{ imageUrl }}" {% if presentUrl %}data-present-src="{{ presentUrl }}"{% endif %} alt="{{ video.title or motion.title }}">
          {% endif %}
          {% if video.title %}
            <figcaption><strong>{{ video.title }}</strong></figcaption>
          {% endif %}
          {% if video.description %}
            <figcaption>{{ video.description }}</figcaption>
          {% endif %}
        </figure>
      {% endfor %}
    </section>
  {% endif %}
</article>

<article>
  <h2>More In Motion</h2>

  {% if inMotion.length > 0 %}
    <ul class="exhibits-grid">
      {% for item in inMotion %}
        {% if item.slug != motion.slug %}
        <li>
          <div>
            {% if item.previewImageUrl %}
              <a href="/in-motion/{{ item.slug }}/">
                <img class="vt-thumb" src="{{ item.previewImageUrl }}" alt="{{ item.title }}" data-vt-name="in-motion-{{ item.slug }}" data-vt-role="grid" {% if item.imageWidth and item.imageHeight %}width="{{ item.imageWidth }}" height="{{ item.imageHeight }}"{% endif %}>
              </a>
            {% endif %}
            <h2 class="item-title">
              <a href="/in-motion/{{ item.slug }}/">{{ item.title }}</a>
            </h2>
          </div>
        </li>
        {% endif %}
      {% endfor %}
    </ul>
  {% endif %}
</article>
