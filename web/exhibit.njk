---
pagination:
  data: exhibits
  size: 1
  alias: exhibit
permalink: "exhibits/{{ exhibit.slug }}/"
layout: layouts/base.njk
templateClass: tmpl-exhibit
---

<p><a href="{{ '/exhibits/' | url }}" class="back-link">← Exhibits</a></p>

<article>
  <h1>{{ exhibit.title }}</h1>

  {% if exhibit.venue or exhibit.location %}
  <p>
    {% if exhibit.venue %}<strong>{{ exhibit.venue }}</strong>{% endif %}
    {% if exhibit.venue and exhibit.location %} | {% endif %}
    {% if exhibit.location %}{{ exhibit.location }}{% endif %}
    {% if exhibit.description %} | {{ exhibit.description }} {% endif %}
    {% if exhibit.photoCredit %} | Photography: {{ exhibit.photoCredit }}{% endif %}
    {% if exhibit.relatedInMotion and exhibit.relatedInMotion.slug %} | Video link: <a href="/in-motion/{{ exhibit.relatedInMotion.slug }}/">{{ exhibit.relatedInMotion.title }}</a></p>{% endif %}
  </p>
  {% endif %}

  {% if exhibit.images or exhibit.previewImageUrl %}
    <section class="carousel carousel--scroll-buttons carousel--scroll-markers">
      {# Same asset+URL as list/home thumbs so the morph doesn't crossfade different crops #}
      {% if exhibit.previewImageUrl %}
        <figure class="carousel__slide" data-label="{{ exhibit.title }}">
          <img
            class="vt-thumb vt-thumb--hero"
            src="{{ exhibit.previewImageUrl }}"
            alt="{{ exhibit.title }}"
            data-vt-name="exhibit-{{ exhibit.slug }}"
            style="view-transition-name: exhibit-{{ exhibit.slug }};"
            width="800"
            height="450"
          >
        </figure>
      {% endif %}
      {% for image in exhibit.images %}
        {% set skipMain = exhibit.mainImage and image.asset and exhibit.mainImage.asset and image.asset._ref == exhibit.mainImage.asset._ref %}
        {% if image.asset and not skipMain %}
          {% set imageUrl = metadata.imageUrl(image, 1200) %}
          <figure class="carousel__slide" data-label="Slide {{ loop.index }}">
            <img src="{{ imageUrl }}" alt="{{ image.alt or exhibit.title }}">
            {% if image.caption %}
              <figcaption>{{ image.caption }}</figcaption>
            {% endif %}
          </figure>
        {% elif image.asset and skipMain and image.caption and exhibit.previewImageUrl %}
          {# Caption for main image lives on the hero slide above; skip duplicate frame #}
        {% endif %}
      {% endfor %}
    </section>
  {% endif %}

</article>

<article>

<h2>More Exhibits</h2>

{% if exhibits.length > 0 %}
    <ul class="exhibits-grid">
      {% for exhibitItem in exhibits %}
        {% if exhibitItem.slug != exhibit.slug %}
        <li>
          <div>
            {% if exhibitItem.previewImageUrl %}
              <a href="/exhibits/{{ exhibitItem.slug }}/">
                <img class="vt-thumb" src="{{ exhibitItem.previewImageUrl }}" alt="{{ exhibitItem.title }}" data-vt-name="exhibit-{{ exhibitItem.slug }}" style="view-transition-name: exhibit-{{ exhibitItem.slug }};" width="800" height="450">
              </a>
            {% endif %}
            <h2 class="item-title">
              <a href="/exhibits/{{ exhibitItem.slug }}/">{{ exhibitItem.title }}</a>
            </h2>
          </div>
        </li>
        {% endif %}
      {% endfor %}
    </ul>
  {% endif %}

</article>
