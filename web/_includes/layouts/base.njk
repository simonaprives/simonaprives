<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="view-transition" content="same-origin">
    <title>{{ renderData.title or title or metadata.title }}</title>
    <meta name="Description" content="{{ renderData.description or description or metadata.description }}">
    <link rel="stylesheet" href="{{ '/assets/css/index.css' | url }}">
    {% set previewUrl = null %}
    {% if (post is defined) and post.previewImageUrl %}
      {% set previewUrl = post.previewImageUrl %}
    {% elif (aboutPage is defined) and aboutPage.mainImageUrl %}
      {% set previewUrl = aboutPage.mainImageUrl %}
    {% elif metadata.previewImageUrl %}
      {% set previewUrl = metadata.previewImageUrl %}
    {% elif (renderData.mainImage or mainImage) %}
      {% set pageImage = (renderData.mainImage or mainImage) %}
      {% set previewUrl = metadata.imageUrl(pageImage, 1200) %}
    {% endif %}
    {% if previewUrl %}
      <meta property="og:image" content="{{ previewUrl }}">
      <meta name="twitter:card" content="summary_large_image">
      <meta name="twitter:image" content="{{ previewUrl }}">
    {% endif %}
      {# <link rel="alternate" href="{{ metadata.feed.path | url }}" type="application/atom+xml" title="{{ metadata.title }}"> #}
  </head>
  <body>
    <header>
      <div class="home"><a href="{{ '/' | url }}"><img class="logo" src="{% if templateClass == 'tmpl-home' %}/assets/images/Logo-white-web.png{% else %}/assets/images/logo-simona.png{% endif %}" alt"{{ metadata.title }}" /></a></div>
      <button class="mobile-menu-toggle" aria-label="Toggle menu" aria-expanded="false">
        <span></span>
        <span></span>
        <span></span>
      </button>
      <nav class="nav-desktop">
        <ul class="nav">
          {%- for nav in collections.topNav | sort(attribute="data.navOrder") -%}
          <li class="nav-item{% if nav.url == page.url %} nav-item-active{% endif %}"><a href="{{ nav.url | url }}">{{ nav.data.navtitle }}</a></li>
          {%- endfor -%}
        </ul>
        {% include "components/social-links.njk" %}
      </nav>
    </header>
    
    <div class="mobile-menu" id="mobileMenu">
      <div class="mobile-menu__header">
        <div class="home"><a href="{{ '/' | url }}"><img class="logo" src="/assets/images/logo-simona.png" alt"{{ metadata.title }}" /></a></div>
        <button class="mobile-menu__close" aria-label="Close menu">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M18 6L6 18M6 6L18 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>
      <nav class="mobile-menu__nav">
        <ul class="mobile-nav-list mobile-nav-list--primary">
          {%- for nav in collections.topNav | sort(attribute="data.navOrder") -%}
          {%- if nav.data.navtitle != 'About' and nav.data.navtitle != 'CV' -%}
          <li><a href="{{ nav.url | url }}"{% if nav.url == page.url %} aria-current="page"{% endif %}>{{ nav.data.navtitle }}</a></li>
          {%- endif -%}
          {%- endfor -%}
        </ul>
        <ul class="mobile-nav-list mobile-nav-list--secondary">
          {%- for nav in collections.nav | sort(attribute="data.navOrder") -%}
          {%- if nav.data.navtitle == 'About' or nav.data.navtitle == 'CV' or nav.data.navtitle == 'Biolinks' -%}
          <li><a href="{{ nav.url | url }}"{% if nav.url == page.url %} aria-current="page"{% endif %}>{{ nav.data.navtitle }}</a></li>
          {%- endif -%}
          {%- endfor -%}
        </ul>
        {% include "components/social-links.njk" %}
      </nav>
    </div>

    <main{% if templateClass %} class="{{ templateClass }}"{% endif %}>
      {{ content | safe }}
    </main>

    <footer>
        <nav>
          <ul>
            {%- for nav in collections.nav | reverse -%}
            <li><a href="{{ nav.url | url }}">{{ nav.data.navtitle }}</a></li>
            {%- endfor -%}
          </ul>
        </nav>
        <p> © {{ helpers.currentYear() }} Simona Prives</p>
    </footer>
    
    <script src="{{ '/assets/js/mobile-nav.js' | url }}"></script>
    {% if templateClass == 'tmpl-cv' %}
    <script src="{{ '/assets/js/cv-tabs.js' | url }}"></script>
    {% endif %}
    {% if templateClass == 'tmpl-exhibit' %}
    <script src="{{ '/assets/js/back-navigation.js' | url }}"></script>
    {% endif %}
    {% if js %}
    		<script type="module" src="{{ js }}"></script>
		{% endif %}
    <!-- Current page: {{ page.url | url }} -->
  </body>
</html>
