---
layout: layouts/base.njk
templateClass: tmpl-in-motion-list
tags:
  - nav
  - topNav
navtitle: In Motion
navOrder: 2
permalink: in-motion/index.html
---

<p><a href="{{ '/' | url }}">← Home</a></p>

<article>
  <h1>In Motion</h1>

  {% if inMotion.length > 0 %}
    <section class="carousel carousel--scroll-buttons carousel--scroll-markers">
      {% for item in inMotion %}
        <figure class="carousel__slide" data-label="{{ item.title }}">
          {% if item.videos[0] and item.videos[0].videoUrl %}
            <div class="video-embed">
              {% set videoId = item.videos[0].videoUrl | replace("https://vimeo.com/", "") | replace("https://player.vimeo.com/video/", "") %}
              <iframe 
                src="https://player.vimeo.com/video/{{ videoId }}" 
                frameborder="0" 
                allow="fullscreen; picture-in-picture" 
                allowfullscreen
                style="view-transition-name: in-motion-{{ item.slug }};"
              ></iframe>
            </div>
          {% endif %}
          <figcaption>
            <a href="/in-motion/{{ item.slug }}/">{{ item.title }}</a>
          </figcaption>
        </figure>
      {% endfor %}
    </section>
    </article>
    <article>
      <h2>All Works In Motion</h2>
      <ul class="exhibits-grid">
        {% for item in inMotion %}
          <li>
            <div>
              {% if item.previewImageUrl %}
                <a href="/in-motion/{{ item.slug }}/">
                  <img src="{{ item.previewImageUrl }}" alt="{{ item.title }}" style="view-transition-name: in-motion-{{ item.slug }};">
                </a>
              {% endif %}
              <h2 class="item-title">
                <a href="/in-motion/{{ item.slug }}/">{{ item.title }}</a>
              </h2>
            </div>
          </li>
        {% endfor %}
      </ul>
  {% endif %}
  </article>

