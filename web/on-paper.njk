---
layout: layouts/base.njk
templateClass: tmpl-on-paper
tags:
  - nav
  - topNav
navtitle: On Paper
navOrder: 3
permalink: on-paper/index.html
---

<article>
  <h1>{{ onPaper.title }}</h1>

  {# {% if onPaper.description %}
    <p>{{ onPaper.description }}</p>
  {% endif %} #}

  {% if onPaper.images1 %}
    <section class="carousel carousel--scroll-buttons carousel--scroll-markers" data-present-id="on-paper">
      {% for artwork in onPaper.images1 %}
        <figure class="carousel__slide" data-label="Slide {{ loop.index }}">
          {% if artwork.mainImage and artwork.mainImage.asset %}
            {% set imageUrl = metadata.imageUrl(artwork.mainImage, 1200) %}
            {% set presentUrl = metadata.imageUrl(artwork.mainImage, 2400) %}
            <img src="{{ imageUrl }}" {% if presentUrl %}data-present-src="{{ presentUrl }}"{% endif %} alt="{{ artwork.title or onPaper.title }}">
            {% if artwork.title or artwork.dimensions or artwork.description %}
              <figcaption>
                {% if artwork.title %}<strong>{{ artwork.title }}</strong>{% endif %}
                {% if artwork.dimensions %} | {{ artwork.dimensions }}{% endif %}
                {% if artwork.description %} | {{ artwork.description }}{% endif %}
              </figcaption>
            {% endif %}
          {% endif %}
        </figure>
      {% endfor %}
    </section>
  {% endif %}
</article>
